p-6\"><div class=\"text-4xl md:text-5xl font-black text-white mb-2 tracking-tight\">0<span class=\"text-indigo-500\">+</span></div><div class=\"text-sm font-medium text-slate-400 uppercase tracking-widest\">PDF Doküman</div></div><div class=\"flex flex-col items-center text-center p-6\"><div class=\"text-4xl md:text-5xl font-black text-white mb-2 tracking-tight\">0<span class=\"text-indigo-500\">+</span></div><div class=\"text-sm font-medium text-slate-400 uppercase tracking-widest\">Workshop</div></div><div class=\"flex flex-col items-center text-center p-6\"><div class=\"text-4xl md:text-5xl font-black text-white mb-2 tracking-tight\">0<span class=\"text-indigo-500\">+</span></div><div class=\"text-sm font-medium text-slate-400 uppercase tracking-widest\">Başarı Rozeti</div></div></div></div></section><section class=\"py-24 relative\"><div class=\"max-w-7xl mx-auto px-6 md:px-12\"><div class=\"text-center max-w-3xl mx-auto mb-16\"><h2 class=\"text-3xl md:text-5xl font-bold text-white mb-6\" style=\"opacity:0;transform:translateY(20px)\">İçeriden Bir Bakış</h2><p class=\"text-slate-400 text-lg leading-relaxed\" style=\"opacity:0;transform:translateY(20px)\">Modern, hızlı ve dikkat dağıtmayan Premium arayüz ile sadece öğrenmeye odaklanın.</p></div><div class=\"flex flex-wrap items-center justify-center gap-2 mb-8\"><button class=\"px-5 py-2.5 rounded-full text-sm font-semibold transition-all bg-indigo-500 text-white shadow-lg shadow-indigo-500/25\">Dashboard</button><button class=\"px-5 py-2.5 rounded-full text-sm font-semibold transition-all bg-slate-900/50 text-slate-400 hover:text-white hover:bg-slate-800\">Course Player</button><button class=\"px-5 py-2.5 rounded-full text-sm font-semibold transition-all bg-slate-900/50 text-slate-400 hover:text-white hover:bg-slate-800\">Workshop</button><button class=\"px-5 py-2.5 rounded-full text-sm font-semibold transition-all bg-slate-900/50 text-slate-400 hover:text-white hover:bg-slate-800\">Achievements</button></div><div class=\"relative rounded-2xl border border-white/10 bg-slate-900/50 p-2 shadow-2xl backdrop-blur-sm overflow-hidden min-h-[300px] md:min-h-[600px]\"><div class=\"relative aspect-[16/10] md:aspect-[16/9] w-full rounded-xl overflow-hidden bg-slate-950\" style=\"opacity:0;transform:scale(0.98)\"><img alt=\"Dashboard\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"100vw\" srcSet=\"/_next/image?url=https%3A%2F%2Fimages.unsplash.com%2Fphoto-1551288049-bebda4e38f71%3Fq%3D80%26w%3D2000%26auto%3Dformat%26fit%3Dcrop&amp;w=640&amp;q=75 640w, /_next/image?url=https%3A%2F%2Fimages.unsplash.com%2Fphoto-1551288049-bebda4e38f71%3Fq%3D80%26w%3D2000%26auto%3Dformat%26fit%3Dcrop&amp;w=750&amp;q=75 750w, /_next/image?url=https%3A%2F%2Fimages.unsplash.com%2Fphoto-1551288049-bebda4e38f71%3Fq%3D80%26w%3D2000%26auto%3Dformat%26fit%3Dcrop&amp;w=828&amp;q=75 828w, /_next/image?url=https%3A%2F%2Fimages.unsplash.com%2Fphoto-1551288049-bebda4e38f71%3Fq%3D80%26w%3D2000%26auto%3Dformat%26fit%3Dcrop&amp;w=1080&amp;q=75 1080w, /_next/image?url=https%3A%2F%2Fimages.unsplash.com%2Fphoto-1551288049-bebda4e38f71%3Fq%3D80%26w%3D2000%26auto%3Dformat%26fit%3Dcrop&amp;w=1200&amp;q=75 1200w, /_next/image?url=https%3A%2F%2Fimages.unsplash.com%2Fphoto-1551288049-bebda4e38f71%3Fq%3D80%26w%3D2000%26auto%3Dformat%26fit%3Dcrop&amp;w=1920&amp;q=75 1920w, /_next/image?url=https%3A%2F%2Fimages.unsplash.com%2Fphoto-1551288049-bebda4e38f71%3Fq%3D80%26w%3D2000%26auto%3Dformat%26fit%3Dcrop&amp;w=2048&amp;q=75 2048w, /_next/image?url=https%3A%2F%2Fimages.unsplash.com%2Fphoto-1551288049-bebda4e38f71%3Fq%3D80%26w%3D2000%26auto%3Dformat%26fit%3Dcrop&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=https%3A%2F%2Fimages.unsplash.com%2Fphoto-1551288049-bebda4e38f71%3Fq%3D80%26w%3D2000%26auto%3Dformat%26fit%3Dcrop&amp;w=3840&amp;q=75\"/></div></div></div></section><section class=\"py-24 relative bg-slate-950\"><div class=\"max-w-7xl mx-auto px-6 md:px-12\"><div class=\"grid lg:grid-cols-2 gap-16 items-center\"><div><h2 class=\"text-3xl md:text-5xl font-bold text-white mb-6 leading-tight\" style=\"opacity:0;transform:translateY(20px)\">Neden Binlerce Kişi Bizi Tercih Ediyor?</h2><p class=\"text-slate-400 text-lg leading-relaxed mb-8\" style=\"opacity:0;transform:translateY(20px)\">Çünkü biz sadece bir eğitim satmıyoruz, baştan uca bir kariyer dönüşüm ekosistemi sunuyoruz. En yeni teknolojilerle donatılmış platformumuzda başarı tesadüf değildir.</p></div><div class=\"grid sm:grid-cols-2 gap-6\"><div class=\"p-6 rounded-2xl bg-slate-900/40 border border-white/5 hover:bg-slate-800/60 transition-colors\" style=\"opacity:0;transform:translateY(20px)\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-layout-template w-8 h-8 text-indigo-400 mb-4\" aria-hidden=\"true\"><rect width=\"18\" height=\"7\" x=\"3\" y=\"3\" rx=\"1\"></rect><rect width=\"9\" height=\"7\" x=\"3\" y=\"14\" rx=\"1\"></rect><rect width=\"5\" height=\"7\" x=\"16\" y=\"14\" rx=\"1\"></rect></svg><h3 class=\"text-xl font-bold text-white mb-2\">Premium Arayüz</h3><p class=\"text-sm text-slate-400 leading-relaxed\">Apple ve Linear sadeliğinde tasarlanmış, göz yormayan ve tamamen öğrenmeye odaklı özel platform.</p></div><div class=\"p-6 rounded-2xl bg-slate-900/40 border border-white/5 hover:bg-slate-800/60 transition-colors\" style=\"opacity:0;transform:translateY(20px)\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-briefcase w-8 h-8 text-indigo-400 mb-4\" aria-hidden=\"true\"><path d=\"M16 20V4a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16\"></path><rect width=\"20\" height=\"14\" x=\"2\" y=\"6\" rx=\"2\"></rect></svg><h3 class=\"text-xl font-bold text-white mb-2\">Gerçek Projeler</h3><p class=\"text-sm text-slate-400 leading-relaxed\">Teorik bilgileri değil, sektörde birebir karşılığı olan gerçek dünya senaryolarını öğretiyoruz.</p></div><div class=\"p-6 rounded-2xl bg-slate-900/40 border border-white/5 hover:bg-slate-800/60 transition-colors\" style=\"opacity:0;transform:translateY(20px)\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-medal w-8 h-8 text-indigo-400 mb-4\" aria-hidden=\"true\"><path d=\"M7.21 15 2.66 7.14a2 2 0 0 1 .13-2.2L4.4 2.8A2 2 0 0 1 6 2h12a2 2 0 0 1 1.6.8l1.6 2.14a2 2 0 0 1 .14 2.2L16.79 15\"></path><path d=\"M11 12 5.12 2.2\"></path><path d=\"m13 12 5.88-9.8\"></path><path d=\"M8 7h8\"></path><circle cx=\"12\" cy=\"17\" r=\"5\"></circle><path d=\"M12 18v-2h-.5\"></path></svg><h3 class=\"text-xl font-bold text-white mb-2\">Başarı Sistemi</h3><p class=\"text-sm text-slate-400 leading-relaxed\">Oyunlaştırma (Gamification) altyapısı ile motivasyonunuzu her zaman en üst seviyede tutun.</p></div><div class=\"p-6 rounded-2xl bg-slate-900/40 border border-white/5 hover:bg-slate-800/60 transition-colors\" style=\"opacity:0;transform:translateY(20px)\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-refresh-cw w-8 h-8 text-indigo-400 mb-4\" aria-hidden=\"true\"><path d=\"M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8\"></path><path d=\"M21 3v5h-5\"></path><path d=\"M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16\"></path><path d=\"M8 16H3v5\"></path></svg><h3 class=\"text-xl font-bold text-white mb-2\">Her Zaman Güncel</h3><p class=\"text-sm text-slate-400 leading-relaxed\">YouTube algoritması değiştikçe eğitimlerimiz de güncellenir. Asla geride kalmazsınız.</p></div></div></div></div></section><section id=\"faq\" class=\"py-24 relative\"><div class=\"max-w-3xl mx-auto px-6 md:px-12\"><div class=\"text-center mb-16\"><h2 class=\"text-3xl md:text-5xl font-bold text-white mb-6\" style=\"opacity:0;transform:translateY(20px)\">Sıkça Sorulan Sorular</h2><p class=\"text-slate-400 text-lg\" style=\"opacity:0;transform:translateY(20px)\">Aklınıza takılan soruların cevaplarını burada bulabilirsiniz.</p></div><div class=\"space-y-4\"><div class=\"rounded-2xl border border-white/10 bg-slate-900/30 overflow-hidden\" style=\"opacity:0;transform:translateY(10px)\"><button class=\"w-full flex items-center justify-between p-6 text-left\"><span class=\"font-semibold text-white text-lg\">Eğitimlere erişim süresi ne kadar?</span><div class=\"flex-shrink-0 ml-4 text-indigo-400\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down w-5 h-5\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></div></button><div style=\"height:0px;opacity:0\"><div class=\"px-6 pb-6 text-slate-400 leading-relaxed\">Platforma kayıt olduktan sonra tüm eğitim içeriklerine ömür boyu (sınırsız) erişim hakkınız olur. Güncellemeler için ekstra ücret ödemezsiniz.</div></div></div><div class=\"rounded-2xl border border-white/10 bg-slate-900/30 overflow-hidden\" style=\"opacity:0;transform:translateY(10px)\"><button class=\"w-full flex items-center justify-between p-6 text-left\"><span class=\"font-semibold text-white text-lg\">Sıfırdan başlayanlar için uygun mu?</span><div class=\"flex-shrink-0 ml-4 text-indigo-400\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down w-5 h-5\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></div></button></div><div class=\"rounded-2xl border border-white/10 bg-slate-900/30 overflow-hidden\" style=\"opacity:0;transform:translateY(10px)\"><button class=\"w-full flex items-center justify-between p-6 text-left\"><span class=\"font-semibold text-white text-lg\">Eğitimleri telefondan izleyebilir miyim?</span><div class=\"flex-shrink-0 ml-4 text-indigo-400\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down w-5 h-5\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></div></button></div><div class=\"rounded-2xl border border-white/10 bg-slate-900/30 overflow-hidden\" style=\"opacity:0;transform:translateY(10px)\"><button class=\"w-full flex items-center justify-between p-6 text-left\"><span class=\"font-semibold text-white text-lg\">Sertifika veriyor musunuz?</span><div class=\"flex-shrink-0 ml-4 text-indigo-400\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down w-5 h-5\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></div></button></div></div></div></section><section class=\"py-24 relative overflow-hidden\"><div class=\"absolute inset-0 bg-gradient-to-b from-transparent to-indigo-950/20 pointer-events-none\"></div><div class=\"max-w-5xl mx-auto px-6 md:px-12 relative z-10\"><div class=\"rounded-3xl bg-gradient-to-br from-indigo-600 to-purple-700 p-10 md:p-16 text-center shadow-2xl shadow-indigo-500/20 overflow-hidden relative\" style=\"opacity:0;transform:scale(0.95)\"><div class=\"absolute top-0 right-0 -mt-10 -mr-10 w-40 h-40 bg-white/10 rounded-full blur-2xl\"></div><div class=\"absolute bottom-0 left-0 -mb-10 -ml-10 w-40 h-40 bg-black/10 rounded-full blur-2xl\"></div><div class=\"relative z-10\"><h2 class=\"text-4xl md:text-6xl font-extrabold text-white mb-6 tracking-tight\">Bugün Başla.</h2><p class=\"text-lg md:text-xl text-indigo-100 mb-10 max-w-2xl mx-auto\">YouTube kariyerine ilk adımını at. Sıfırdan profesyonelliğe uzanan bu yolculukta sana rehberlik etmek için buradayız.</p><a href=\"/login\"><button class=\"inline-flex items-center justify-center font-medium transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-indigo-500/40 disabled:opacity-50 disabled:pointer-events-none rounded-xl active:scale-[0.98] shadow-indigo-500/25 border border-indigo-500/30 gap-2.5 bg-white text-indigo-600 hover:bg-slate-50 border-none shadow-xl h-14 px-10 text-lg group\">Hemen Başla<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right w-5 h-5 text-indigo-500 group-hover:translate-x-1 transition-transform\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></button></a></div></div></div></section></main><footer class=\"bg-slate-950 border-t border-white/10 pt-16 pb-8\"><div class=\"max-w-7xl mx-auto px-6 md:px-12\"><div class=\"grid grid-cols-1 md:grid-cols-4 gap-12 mb-16\"><div class=\"md:col-span-2\"><a class=\"flex items-center gap-3 mb-6\" href=\"/\"><div class=\"p-2 rounded-xl bg-gradient-to-br from-indigo-500 to-purple-600 text-white shadow-md shadow-indigo-500/25\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-layers w-5 h-5\" aria-hidden=\"true\"><path d=\"M12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0